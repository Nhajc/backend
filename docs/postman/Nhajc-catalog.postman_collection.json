                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "pm.test(\"releases đã phân trang\",function(){const b=pm.response.json();pm.expect(b).not.to.have.property(\"summary\");pm.expect(b.releases).to.have.all.keys(\"content\",\"page\",\"size\",\"hasNext\");pm.expect(b.releases.page).to.eql(Number(pm.variables.get(\"page\")));pm.expect(b.releases.size).to.eql(Number(pm.variables.get(\"size\")));});"
                ]
              }
            }
          ]
        },
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/genres?page={{page}}&size={{size}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "pm.test(\"PageResponse: content/page/size/hasNext\",function(){const b=pm.response.json();pm.expect(b).to.have.all.keys(\"content\",\"page\",\"size\",\"hasNext\");pm.expect(b.content).to.be.an(\"array\");pm.expect(b.page).to.eql(Number(pm.variables.get(\"page\")));pm.expect(b.size).to.eql(Number(pm.variables.get(\"size\")));pm.expect(b.hasNext).to.be.a(\"boolean\");});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search all",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/search?q={{q}}&page={{page}}&size={{size}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "pm.test(\"PageResponse: content/page/size/hasNext\",function(){const b=pm.response.json();pm.expect(b).to.have.all.keys(\"content\",\"page\",\"size\",\"hasNext\");pm.expect(b.content).to.be.an(\"array\");pm.expect(b.page).to.eql(Number(pm.variables.get(\"page\")));pm.expect(b.size).to.eql(Number(pm.variables.get(\"size\")));pm.expect(b.hasNext).to.be.a(\"boolean\");});",
                  "pm.test(\"Mixed item có type, không bọc item\",function(){pm.response.json().content.forEach(x=>{pm.expect(x.type).to.be.oneOf([\"SONG\",\"RELEASE\",\"PLAYLIST\",\"ARTIST\"]);pm.expect(x).not.to.have.property(\"item\");});});"
