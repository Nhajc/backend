{
  "info": {
    "name": "Nhajc API - Catalog & Library",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API phần 1.3 và 1.4. Điền tài khoản có sẵn, artistId/releaseId/songId từ Admin. Chạy đúng thứ tự với page=0. Tạo rồi tự xóa playlist/comment của đợt test; thay đổi trạng thái lưu/follow/favorite của ID bạn cung cấp. Muốn chỉ xem thì gửi các request GET riêng. Response list có content,page,size,hasNext."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Login",
      "item": [
        {
          "name": "Login tài khoản có sẵn",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function resolve(v){if(typeof v===\"string\")return pm.variables.replaceIn(v);if(Array.isArray(v))return v.map(resolve);if(v&&typeof v===\"object\")Object.keys(v).forEach(k=>v[k]=resolve(v[k]));return v;}",
                  "pm.request.body.update(JSON.stringify(resolve(JSON.parse(pm.request.body.raw))));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "if(pm.response.code===200){const b=pm.response.json();pm.environment.set(\"accessToken\",b.accessToken);pm.environment.set(\"refreshToken\",b.refreshToken);pm.environment.set(\"userId\",b.user.id);}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Catalog & Search",
      "item": [
        {
          "name": "Get release + trang bài hát",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/releases/{{releaseId}}?page={{page}}&size={{size}}",
            "header": []
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "[\"releaseId\"].forEach(key=>{if(!pm.variables.get(key))throw new Error(\"Thiếu \"+key+\". Tạo dữ liệu trước rồi điền ID thật vào environment.\");});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "pm.test(\"songs đã phân trang\",function(){const b=pm.response.json();pm.expect(b).not.to.have.property(\"summary\");pm.expect(b.songs).to.have.all.keys(\"content\",\"page\",\"size\",\"hasNext\");pm.expect(b.songs.page).to.eql(Number(pm.variables.get(\"page\")));pm.expect(b.songs.size).to.eql(Number(pm.variables.get(\"size\")));});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get artist + trang releases",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/artists/{{artistId}}?page={{page}}&size={{size}}",
