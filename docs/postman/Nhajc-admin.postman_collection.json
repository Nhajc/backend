        {
          "name": "11 - Duplicate genre → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/genres",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Gửi lại genreName đã tạo để kiểm tra trùng tên.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{genreName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload=JSON.parse(pm.request.body.raw);",
                  "function resolve(value){if(typeof value===\"string\")return pm.variables.replaceIn(value);if(Array.isArray(value))return value.map(resolve);if(value&&typeof value===\"object\")Object.keys(value).forEach(key=>value[key]=resolve(value[key]));return value;}",
                  "pm.request.body.update(JSON.stringify(resolve(payload)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\",function(){pm.response.to.have.status(409);});"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Release thiếu artists → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/releases",
            "header": [],
            "description": "Multipart thiếu artistIds, phải trả 400.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Invalid",
                  "type": "text"
                },
                {
                  "key": "releaseType",
