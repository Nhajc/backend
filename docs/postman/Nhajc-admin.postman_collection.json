{
  "info": {
    "_postman_id": "bf6eaf0a-70e2-4bfc-ba1d-80f518847c90",
    "name": "Nhajc API - Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API Admin đã triển khai. Import Nhajc-admin.postman_environment.json, điền tài khoản ADMIN rồi chạy theo thứ tự. Các tài nguyên tạo ra được giữ lại. Upload bỏ qua nếu chưa chọn file; xóa comment bỏ qua nếu chưa điền commentId. Không cấp quyền ADMIN qua API register. Xem docs/admin.md và docs/postman/README.md. Có sẵn fake data: autoGenerateData=true tự sinh tên/tiêu đề; Ảnh avatar/cover chọn bằng File trong form-data; chưa chọn thì bỏ ảnh tùy chọn. File FLAC mẫu nằm trong docs/postman/fixtures. Xem fake-data.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "type": "string",
        "value": "{{adminAccessToken}}"
      }
    ]
  },
  "item": [
    {
      "name": "Admin workflow",
      "item": [
        {
          "name": "01 - Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Điền adminUsername và adminPassword trong environment. Tài khoản cần được cấp ADMIN trong database trước, rồi đăng nhập lại để lấy JWT mới.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get(\"adminUsername\")||!pm.environment.get(\"adminPassword\"))throw new Error(\"Điền adminUsername và adminPassword trong Nhajc Admin Local.\");",
                  "const payload=JSON.parse(pm.request.body.raw);",
                  "function resolve(value){if(typeof value===\"string\")return pm.variables.replaceIn(value);if(Array.isArray(value))return value.map(resolve);if(value&&typeof value===\"object\")Object.keys(value).forEach(key=>value[key]=resolve(value[key]));return value;}",
                  "pm.request.body.update(JSON.stringify(resolve(payload)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "if(pm.response.code===200){const body=pm.response.json();pm.test(\"Tài khoản có role ADMIN\",function(){pm.expect(body.user.role).to.eql(\"ADMIN\");});if(body.user.role===\"ADMIN\")pm.environment.set(\"adminAccessToken\",body.accessToken);else pm.environment.unset(\"adminAccessToken\");}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Create genre",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/genres",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "autoGenerateData=true tự sinh tên thể loại có hậu tố duy nhất. Đặt false để dùng genreName tự nhập. Lưu genreId cho release.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{genreName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (String(pm.environment.get(\"autoGenerateData\")).toLowerCase()===\"true\") {",
                  "    const names=[\"Pop\", \"Rock\", \"Jazz\", \"Nhạc điện tử\"];",
                  "    pm.environment.set(\"genreName\", names[Math.floor(Math.random()*names.length)]+\" demo \"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 8));",
                  "}",
                  "if(!pm.environment.get(\"genreName\")) throw new Error(\"Điền genreName hoặc đặt autoGenerateData=true.\");",
                  "const payload=JSON.parse(pm.request.body.raw);",
                  "function resolve(value) {",
                  "    if (typeof value === \"string\") return pm.variables.replaceIn(value);",
                  "    if (Array.isArray(value)) return value.map(resolve);",
                  "    if (value && typeof value === \"object\") Object.keys(value).forEach(key=>value[key]=resolve(value[key]));",
                  "    return value;",
                  "}",
                  "const resolved=resolve(payload);",
                  "pm.request.body.update(JSON.stringify(resolved));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",function(){pm.response.to.have.status(201);});",
                  "if(pm.response.code===201){pm.test(\"IdResponse là object\",function(){pm.expect(pm.response.json()).to.have.all.keys(\"id\");});pm.environment.set(\"genreId\",pm.response.json().id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - List genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/genres?page={{genrePage}}&size={{genreSize}}",
            "header": [],
            "description": "Danh sách phân trang: page bắt đầu từ 0, size 1–100 (mặc định 20). Sửa genrePage/genreSize trong environment hoặc Params. Response {content:[{id,name,slug}],page,size,hasNext}. Khi hasNext=true tăng page thêm 1. Thể loại vừa tạo có thể nằm ở trang khác vì danh sách sắp theo tên. Trang vượt dữ liệu trả content=[],hasNext=false. USER và ADMIN đều được đọc."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.environment.get(\"genrePage\")==null || pm.environment.get(\"genrePage\")===\"\")pm.environment.set(\"genrePage\",\"0\");",
                  "if(pm.environment.get(\"genreSize\")==null || pm.environment.get(\"genreSize\")===\"\")pm.environment.set(\"genreSize\",\"20\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",function(){pm.response.to.have.status(200);});",
                  "if(pm.response.code===200){",
                  "    const body=pm.response.json();",
                  "    pm.test(\"PageResponse có content, page, size, hasNext\",function(){",
                  "        pm.expect(body).to.have.all.keys(\"content\",\"page\",\"size\",\"hasNext\");",
                  "        pm.expect(body.content).to.be.an(\"array\");",
                  "        pm.expect(body.hasNext).to.be.a(\"boolean\");",
                  "        pm.expect(body.content.length).to.be.at.most(Number(pm.variables.replaceIn(\"{{genreSize}}\")));",
                  "    });",
                  "    pm.test(\"Các genre đúng hợp đồng\",function(){",
                  "        body.content.forEach(item=>pm.expect(item).to.have.all.keys(\"id\",\"name\",\"slug\"));",
                  "    });",
                  "}",
                  "if(pm.response.code===200){const b=pm.response.json();pm.test(\"Page/size đúng yêu cầu\",function(){pm.expect(b.page).to.eql(Number(pm.variables.get(\"genrePage\")));pm.expect(b.size).to.eql(Number(pm.variables.get(\"genreSize\")));});}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - Create artist",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/artists",
            "header": [],
            "description": "multipart/form-data: name kiểu Text, avatar kiểu File (tùy chọn). Chọn JPEG/PNG từ máy; không gửi đường dẫn trong Text. Chưa chọn file thì chỉ tạo nghệ sĩ không ảnh. Lưu artistId.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "{{artistName}}",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": null,
                  "description": "Chọn JPEG/PNG tối đa 5 MiB; bỏ chọn dòng này nếu không gửi ảnh."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(String(pm.environment.get(\"autoGenerateData\")).toLowerCase()===\"true\") pm.environment.set(\"artistName\",\"Nghệ sĩ demo \"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0,8));",
                  "if(!pm.environment.get(\"artistName\")) throw new Error(\"Điền artistName hoặc đặt autoGenerateData=true.\");",
                  "const imagePart=pm.request.body.formdata.find(part=>part.key==='avatar');",
                  "if(imagePart && !imagePart.disabled) {",
                  "    const source=imagePart.src;",
                  "    if(!source || (Array.isArray(source) && source.length===0)) imagePart.disabled=true;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",function(){pm.response.to.have.status(201);});",
                  "if(pm.response.code===201){pm.test(\"IdResponse là object\",function(){pm.expect(pm.response.json()).to.have.all.keys(\"id\");});pm.environment.set(\"artistId\",pm.response.json().id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Create release",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/releases",
            "header": [],
            "description": "multipart/form-data: metadata kiểu Text, cover kiểu File (tùy chọn). Ngày yyyy-MM-dd; nhiều artist/genre thì thêm các dòng cùng key artistIds/genreIds, mỗi dòng một UUID. Bỏ dòng genreIds nếu không có thể loại. Không gửi mảng JSON. Lưu releaseId, xóa songId cũ và đặt trackNumber=1.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "{{releaseTitle}}",
                  "type": "text"
                },
                {
                  "key": "releaseType",
                  "value": "{{releaseType}}",
                  "type": "text"
                },
                {
                  "key": "releaseDate",
                  "value": "{{releaseDate}}",
                  "type": "text"
                },
                {
                  "key": "artistIds",
                  "value": "{{artistId}}",
                  "type": "text"
                },
                {
                  "key": "genreIds",
                  "value": "{{genreId}}",
                  "type": "text"
                },
                {
                  "key": "cover",
                  "type": "file",
                  "src": null,
                  "description": "Chọn JPEG/PNG tối đa 5 MiB; bỏ chọn dòng này nếu không gửi ảnh."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(String(pm.environment.get(\"autoGenerateData\")).toLowerCase()===\"true\") {",
                  "    pm.environment.set(\"releaseTitle\",\"Album demo \"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0,8));",
                  "    pm.environment.set(\"releaseDate\",new Date(Date.now()+7*60*60*1000).toISOString().slice(0,10));",
                  "}",
                  "[\"releaseTitle\",\"releaseType\",\"releaseDate\",\"artistId\"].forEach(key=>{if(!pm.environment.get(key)) throw new Error(\"Thiếu \"+key+\". Chạy Create artist trước hoặc điền ID có thật.\");});",
                  "pm.request.body.formdata.each(part=>{if(part.key===\"genreIds\" && !pm.variables.replaceIn(part.value || \"\").trim()) part.disabled=true;});",
                  "const imagePart=pm.request.body.formdata.find(part=>part.key==='cover');",
                  "if(imagePart && !imagePart.disabled) {",
                  "    const source=imagePart.src;",
                  "    if(!source || (Array.isArray(source) && source.length===0)) imagePart.disabled=true;",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",function(){pm.response.to.have.status(201);});",
                  "if(pm.response.code===201){pm.test(\"IdResponse là object\",function(){pm.expect(pm.response.json()).to.have.all.keys(\"id\");});pm.environment.set(\"releaseId\",pm.response.json().id);}",
                  "if(pm.response.code===201){pm.environment.unset(\"songId\");pm.environment.set(\"trackNumber\",\"1\");}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Upload song FLAC",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/releases/{{releaseId}}/songs",
            "header": [],
            "description": "Dùng file docs/postman/fixtures/demo-tone.flac (2 giây, 440 Hz, stereo 44.1 kHz 16-bit, có ảnh nhúng) hoặc demo-mono.flac (1 giây, mono 16 kHz). Chọn file trong Body → form-data → file. Tiêu đề tự sinh; trackNumber phải mới. API trả 201 sau khi đủ 4 file. Không chọn file thì bỏ qua. Sau khi tạo release mới, songId cũ được xóa để không phát nhầm bài lần trước.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "trackNumber",
                  "type": "text",
                  "value": "{{trackNumber}}"
                },
                {
                  "key": "title",
                  "type": "text",
                  "value": "{{songTitle}}"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": null
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (String(pm.environment.get(\"autoGenerateData\")).toLowerCase()===\"true\") pm.environment.set(\"songTitle\", \"Bài hát demo \"+pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 8));",
                  "if(!pm.environment.get(\"songTitle\"))pm.environment.set(\"songTitle\",\"Bài hát demo\");",
                  "const part=pm.request.body.formdata.toJSON().find(item=>item.key===\"file\"&&!item.disabled);const src=part&&part.src;if(!(typeof src===\"string\"&&src.length||Array.isArray(src)&&src.length)){console.info(\"Chọn FLAC ở Body → form-data → file.\");pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",function(){pm.response.to.have.status(201);});",
                  "if(pm.response.code===201){pm.test(\"IdResponse là object\",function(){pm.expect(pm.response.json()).to.have.all.keys(\"id\");});pm.environment.set(\"songId\",pm.response.json().id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Audio low",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/songs/{{songId}}/audio/low",
            "header": [],
            "description": "Trả 302 Location là URL audio ký sẵn. Đã tắt tự follow redirect để thấy Location; sao chép URL vào trình duyệt hoặc request GET mới để tải."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get(\"songId\")){console.info(\"Upload song trước để có songId.\");pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 302\",function(){pm.response.to.have.status(302);});",
                  "if(pm.response.code===302)pm.test(\"Location có chữ ký MinIO\",function(){pm.expect(pm.response.headers.get(\"Location\")).to.include(\"X-Amz-Signature=\");});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
