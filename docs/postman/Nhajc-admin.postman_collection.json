                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\",function(){pm.response.to.have.status(400);});"
                ]
              }
            }
          ]
        },
        {
          "name": "13 - Delete comment (tùy chọn)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/comments/{{commentId}}",
            "header": [],
            "description": "Xóa comment có ID bạn điền, bao gồm replies. Bỏ qua nếu commentId trống. Chỉ điền ID bình luận thử mà bạn muốn xóa."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!pm.environment.get(\"commentId\")){console.info(\"Không có commentId; bỏ qua xóa comment.\");pm.execution.skipRequest();}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\",function(){pm.response.to.have.status(204);});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
