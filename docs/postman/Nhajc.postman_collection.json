    {
      "name": "02 - Users",
      "item": [
        {
          "name": "05 - Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "description": "Tự dùng Bearer {{accessToken}} kế thừa từ collection. Trả UserResponse và lưu avatarUrl vào environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const user = pm.response.json();",
                  "pm.test(\"UserResponse đúng hợp đồng\", function () {",
                  "    pm.expect(user).to.have.all.keys(\"id\", \"username\", \"email\", \"createdAt\", \"role\", \"avatarUrl\");",
                  "    pm.expect(user.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(user.username).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(user.email).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect([\"USER\", \"ADMIN\"]).to.include(user.role);",
                  "    pm.expect(Number.isNaN(Date.parse(user.createdAt))).to.eql(false);",
                  "});",
                  "pm.test(\"Avatar là URL hoặc null\", function () {",
                  "    pm.expect(user.avatarUrl === null || (typeof user.avatarUrl === \"string\" && /^https?:\\/\\//.test(user.avatarUrl))).to.eql(true);",
                  "});",
                  "pm.environment.set(\"userId\", user.id);",
                  "pm.environment.set(\"avatarUrl\", user.avatarUrl || \"\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Upload avatar",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "_charset_",
                  "value": "UTF-8",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": null,
                  "description": "Pick a JPEG/PNG file of at most 5 MB before sending."
                }
              ]
            },
            "description": "Body → form-data → avatar → Select Files: chọn JPEG/PNG tối đa 5 MB. Không tự đặt Content-Type; Postman thêm boundary. Nếu chưa chọn file, request tự bỏ qua. Trả 200 và avatarUrl ký sẵn. Dán URL vào trình duyệt để xem ảnh."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const parts = pm.request.body.formdata.toJSON();",
                  "const avatar = parts.find(function (part) { return part.key === \"avatar\" && !part.disabled; });",
                  "const source = avatar && avatar.src;",
                  "const hasFile = typeof source === \"string\" ? source.length > 0 : Array.isArray(source) && source.length > 0;",
                  "if (!hasFile) {",
                  "    console.info(\"Pick a JPEG/PNG file in Body → form-data → avatar before sending.\");",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    const user = pm.response.json();",
                  "pm.test(\"UserResponse đúng hợp đồng\", function () {",
                  "    pm.expect(user).to.have.all.keys(\"id\", \"username\", \"email\", \"createdAt\", \"role\", \"avatarUrl\");",
                  "    pm.expect(user.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(user.username).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(user.email).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect([\"USER\", \"ADMIN\"]).to.include(user.role);",
                  "    pm.expect(Number.isNaN(Date.parse(user.createdAt))).to.eql(false);",
                  "});",
                  "pm.test(\"Avatar là URL hoặc null\", function () {",
                  "    pm.expect(user.avatarUrl === null || (typeof user.avatarUrl === \"string\" && /^https?:\\/\\//.test(user.avatarUrl))).to.eql(true);",
                  "});",
                  "pm.environment.set(\"userId\", user.id);",
                  "pm.environment.set(\"avatarUrl\", user.avatarUrl || \"\");",
                  "    pm.test(\"Upload trả URL ký sẵn\", function () { pm.expect(user.avatarUrl).to.be.a(\"string\").and.not.empty; });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Remove avatar",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
