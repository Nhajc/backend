{
  "info": {
    "name": "Nhajc API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "7 sample requests for the 6 implemented Auth and Users APIs. Import the Nhajc Local environment, select it, and fill baseUrl, username, email, password (new ones to register). Register, login and refresh save the tokens; logout clears them. Running the whole collection updates and removes the avatar and logs out, so use a test account. Upload is skipped until a file is picked. When running one request alone, call Login first."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Creates a USER account and returns tokens. 201 on success, 409 username or email taken, 400 invalid data. Fill a new test account in the environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Response has the tokens and the account\", function () {",
                  "        pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.user).to.have.property(\"id\");",
                  "        pm.expect(body.user).to.have.property(\"avatarUrl\");",
                  "    });",
                  "    pm.environment.set(\"accessToken\", body.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "    pm.environment.set(\"userId\", body.user.id);",
                  "    pm.environment.set(\"avatarUrl\", body.user.avatarUrl || \"\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Logs in with username or email. 200 on success, 401 bad credentials. Saves the tokens to the environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Response has the tokens and the account\", function () {",
                  "        pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.user).to.have.property(\"id\");",
                  "        pm.expect(body.user).to.have.property(\"avatarUrl\");",
                  "    });",
                  "    pm.environment.set(\"accessToken\", body.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "    pm.environment.set(\"userId\", body.user.id);",
                  "    pm.environment.set(\"avatarUrl\", body.user.avatarUrl || \"\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Sends the current refresh token. 200 replaces both saved tokens. An expired or already used token returns 401 and revokes that session's tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Response has the tokens and the account\", function () {",
                  "        pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.refreshToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.user).to.have.property(\"id\");",
                  "        pm.expect(body.user).to.have.property(\"avatarUrl\");",
                  "    });",
                  "    pm.environment.set(\"accessToken\", body.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "    pm.environment.set(\"userId\", body.user.id);",
                  "    pm.environment.set(\"avatarUrl\", body.user.avatarUrl || \"\");",
                  "}",
                  "if (pm.response.code === 401) {",
                  "    pm.environment.unset(\"accessToken\");",
                  "    pm.environment.unset(\"refreshToken\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "description": "Gets the logged-in account. avatarUrl is a presigned URL (valid 1 hour by default) or null, and is saved to the environment's avatarUrl."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Response has the account and avatar\", function () {",
                  "        pm.expect(body).to.have.all.keys(\"id\", \"username\", \"email\", \"createdAt\", \"role\", \"avatarUrl\");",
                  "    });",
                  "    pm.test(\"Avatar is a presigned URL or null\", function () {",
                  "        const valid = body.avatarUrl === null || (typeof body.avatarUrl === \"string\" && /^https?:\\/\\//.test(body.avatarUrl));",
                  "        pm.expect(valid).to.eql(true);",
                  "    });",
                  "    pm.environment.set(\"userId\", body.id);",
                  "    pm.environment.set(\"avatarUrl\", body.avatarUrl || \"\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "_charset_",
                  "value": "UTF-8",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": null,
                  "description": "Pick a JPEG/PNG file of at most 5 MB before sending."
                }
              ]
            },
            "description": "Pick a file in Body → form-data → avatar; Postman sets the Content-Type and boundary. 200 on success, 400 invalid image, 413 over 5 MB. Skipped until a file is picked, so the avatar isn't removed by accident."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const parts = pm.request.body.formdata.toJSON();",
                  "const avatar = parts.find(function (part) { return part.key === \"avatar\" && !part.disabled; });",
                  "const source = avatar && avatar.src;",
                  "const hasFile = typeof source === \"string\" ? source.length > 0 : Array.isArray(source) && source.length > 0;",
                  "if (!hasFile) {",
                  "    console.info(\"Pick a JPEG/PNG file in Body → form-data → avatar before sending.\");",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Response has the account and avatar\", function () {",
                  "        pm.expect(body).to.have.all.keys(\"id\", \"username\", \"email\", \"createdAt\", \"role\", \"avatarUrl\");",
                  "    });",
                  "    pm.test(\"Avatar is a presigned URL or null\", function () {",
                  "        const valid = body.avatarUrl === null || (typeof body.avatarUrl === \"string\" && /^https?:\\/\\//.test(body.avatarUrl));",
                  "        pm.expect(valid).to.eql(true);",
                  "    });",
                  "    pm.environment.set(\"userId\", body.id);",
                  "    pm.environment.set(\"avatarUrl\", body.avatarUrl || \"\");",
                  "}",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Upload returns an avatar URL\", function () {",
                  "        pm.expect(typeof pm.response.json().avatarUrl === \"string\").to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove avatar",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "_charset_",
                  "value": "UTF-8",
                  "type": "text"
                }
              ]
            },
            "description": "Removes the logged-in account's avatar: a profile PUT with _charset_=UTF-8 and no avatar file part. 200 with avatarUrl=null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Response has the account and avatar\", function () {",
                  "        pm.expect(body).to.have.all.keys(\"id\", \"username\", \"email\", \"createdAt\", \"role\", \"avatarUrl\");",
                  "    });",
                  "    pm.test(\"Avatar is a presigned URL or null\", function () {",
                  "        const valid = body.avatarUrl === null || (typeof body.avatarUrl === \"string\" && /^https?:\\/\\//.test(body.avatarUrl));",
                  "        pm.expect(valid).to.eql(true);",
                  "    });",
                  "    pm.environment.set(\"userId\", body.id);",
                  "    pm.environment.set(\"avatarUrl\", body.avatarUrl || \"\");",
                  "}",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Avatar was removed\", function () {",
                  "        pm.expect(pm.response.json().avatarUrl).to.eql(null);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Revokes this session's refresh tokens. 204 with an empty body, and the saved tokens are cleared. Access tokens already issued stay valid until they expire."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "if (pm.response.code === 204) {",
              "    [\"accessToken\", \"refreshToken\", \"userId\", \"avatarUrl\"].forEach(function (key) {",
              "        pm.environment.unset(key);",
              "    });",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
