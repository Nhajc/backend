  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "01 - Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Tạo tài khoản USER. autoGenerateUser=true sẽ tạo username/email/password mới và lưu vào environment mỗi lần gửi request này. Nếu muốn tự nhập thông tin, đặt autoGenerateUser=false. Username 3–50 ký tự, không @/khoảng trắng; email tối đa 254 ký tự; mật khẩu 12–72 ký tự và tối đa 72 byte UTF-8. Trả 201 và tự lưu token."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (String(pm.environment.get(\"autoGenerateUser\")).toLowerCase() === \"true\") {",
                  "    const suffix = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 16);",
                  "    const username = \"nhajc_\" + suffix;",
                  "    pm.environment.set(\"username\", username);",
                  "    pm.environment.set(\"email\", username + \"@example.com\");",
                  "    pm.environment.set(\"password\", \"Test!\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "}",
                  "[\"username\", \"email\", \"password\"].forEach(function (key) {",
                  "    if (!pm.environment.get(key)) throw new Error(\"Điền \" + key + \" trong Nhajc Local hoặc đặt autoGenerateUser=true.\");",
                  "});",
                  "// Serialize sau khi thay biến để mật khẩu chứa dấu nháy vẫn tạo JSON hợp lệ.",
                  "const payload = JSON.parse(pm.request.body.raw);",
                  "Object.keys(payload).forEach(function (key) {",
                  "    if (typeof payload[key] === \"string\") payload[key] = pm.variables.replaceIn(payload[key]);",
                  "});",
                  "pm.request.body.update(JSON.stringify(payload));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.test(\"Có access token và refresh token\", function () {",
                  "        pm.expect(body).to.have.all.keys(\"accessToken\", \"refreshToken\", \"user\");",
                  "        pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(body.accessToken.split(\".\")).to.have.lengthOf(3);",
                  "        pm.expect(body.refreshToken).to.match(/^[A-Za-z0-9_-]{43}$/);",
                  "    });",
                  "    const user = body.user;",
                  "pm.test(\"UserResponse đúng hợp đồng\", function () {",
                  "    pm.expect(user).to.have.all.keys(\"id\", \"username\", \"email\", \"createdAt\", \"role\", \"avatarUrl\");",
                  "    pm.expect(user.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(user.username).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(user.email).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect([\"USER\", \"ADMIN\"]).to.include(user.role);",
                  "    pm.expect(Number.isNaN(Date.parse(user.createdAt))).to.eql(false);",
                  "});",
                  "pm.test(\"Avatar là URL hoặc null\", function () {",
                  "    pm.expect(user.avatarUrl === null || (typeof user.avatarUrl === \"string\" && /^https?:\\/\\//.test(user.avatarUrl))).to.eql(true);",
                  "});",
                  "pm.environment.set(\"userId\", user.id);",
                  "pm.environment.set(\"avatarUrl\", user.avatarUrl || \"\");",
                  "    pm.environment.set(\"accessToken\", body.accessToken);",
                  "    pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
