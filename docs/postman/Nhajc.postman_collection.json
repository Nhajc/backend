    {
      "name": "04 - Logout",
      "item": [
        {
          "name": "18 - Logout",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Thu hồi nhóm refresh token của phiên hiện tại. Tự xóa accessToken, refreshToken, userId, avatarUrl trong environment. Tạm giữ token đã thu hồi cho request 19. Access token đã cấp vẫn có hiệu lực đến khi hết hạn."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Serialize sau khi thay biến để mật khẩu chứa dấu nháy vẫn tạo JSON hợp lệ.",
                  "const payload = JSON.parse(pm.request.body.raw);",
                  "Object.keys(payload).forEach(function (key) {",
                  "    if (typeof payload[key] === \"string\") payload[key] = pm.variables.replaceIn(payload[key]);",
                  "});",
                  "pm.request.body.update(JSON.stringify(payload));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) {",
                  "    pm.environment.set(\"loggedOutRefreshToken\", pm.environment.get(\"refreshToken\"));",
                  "    [\"accessToken\", \"refreshToken\", \"userId\", \"avatarUrl\"].forEach(function (key) { pm.environment.unset(key); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "19 - Refresh sau logout → 401",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{loggedOutRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Chạy sau request 18. Xác nhận token vừa logout không thể dùng tiếp. Tự xóa biến tạm sau khi kiểm tra."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get(\"loggedOutRefreshToken\")) { console.info(\"Chạy request Logout trước.\"); pm.execution.skipRequest(); }",
                  "// Serialize sau khi thay biến để mật khẩu chứa dấu nháy vẫn tạo JSON hợp lệ.",
                  "const payload = JSON.parse(pm.request.body.raw);",
                  "Object.keys(payload).forEach(function (key) {",
                  "    if (typeof payload[key] === \"string\") payload[key] = pm.variables.replaceIn(payload[key]);",
                  "});",
                  "pm.request.body.update(JSON.stringify(payload));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "if (pm.response.code === 401) pm.environment.unset(\"loggedOutRefreshToken\");"
                ]
              }
            }
          ]
        }
      ]
    }
