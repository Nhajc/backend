    },
    {
      "name": "Duplicate registration - 409",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/register",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Username contains @ - 400",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/register",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"username\": \"invalid@username\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Invalid email - 400",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/register",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"not-an-email\",\n  \"password\": \"{{password}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Short registration password - 400",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/register",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"short\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Password exceeds 72 UTF-8 bytes - 400",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/register",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"€€€€€€€€€€€€€€€€€€€€€€€€€\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Wrong password - 401",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/login",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"wrong_{{$guid}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Missing account - 401",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/login",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"usernameOrEmail\": \"missing_{{$guid}}\",\n  \"password\": \"{{password}}\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Invalid refresh token - 401",
      "method": "POST",
      "url": "{{baseUrl}}/api/v1/auth/refresh",
      "body": {
        "mode": "raw",
        "raw": "{\n  \"refreshToken\": \"not-a-real-refresh-token\"\n}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    {
      "name": "Missing bearer token - 401",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/users/me"
    },
    {
      "name": "Invalid JWT - 401",
      "method": "GET",
      "url": "{{baseUrl}}/api/v1/users/me"
    },
