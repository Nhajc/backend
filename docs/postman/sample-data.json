{
  "note": "Mẫu cho các API hiện có. ID/token phải lấy từ response thật, không dùng UUID ngẫu nhiên thay ID tham chiếu.",
  "register": {
    "method": "POST",
    "path": "/api/v1/auth/register",
    "body": {
      "username": "tester_demo_001",
      "email": "tester_demo_001@example.com",
      "password": "DemoTest!2026"
    }
  },
  "login": {
    "method": "POST",
    "path": "/api/v1/auth/login",
    "body": {
      "usernameOrEmail": "tester_demo_001",
      "password": "DemoTest!2026"
    }
  },
  "refresh": {
    "method": "POST",
    "path": "/api/v1/auth/refresh",
    "body": {
      "refreshToken": "{{refreshToken}}"
    }
  },
  "logout": {
    "method": "POST",
    "path": "/api/v1/auth/logout",
    "body": {
      "refreshToken": "{{refreshToken}}"
    }
  },
  "me": {
    "method": "GET",
    "path": "/api/v1/users/me",
    "authorization": "Bearer {{accessToken}}"
  },
  "updateProfile": {
    "method": "PUT",
    "path": "/api/v1/users/me",
    "bodyType": "form-data",
    "parts": [
      {
        "key": "_charset_",
        "type": "Text",
        "value": "UTF-8"
      },
      {
        "key": "avatar",
        "type": "File",
        "localFile": "fixtures/demo-avatar.png"
      }
    ]
  },
  "removeAvatar": {
    "method": "PUT",
    "path": "/api/v1/users/me",
    "bodyType": "form-data",
    "parts": [
      {
        "key": "_charset_",
        "type": "Text",
        "value": "UTF-8"
      }
    ]
  },
  "genre": {
    "method": "POST",
    "path": "/api/v1/admin/genres",
    "body": {
      "name": "Pop demo 001"
    }
  },
  "genres": {
    "method": "GET",
    "path": "/api/v1/genres?page=0&size=20",
    "response": {
      "content": [
        {
          "id": "{{genreId}}",
          "name": "Pop demo 001",
          "slug": "pop-demo-001-UUID"
        }
      ],
      "hasNext": false,
      "page": 0,
      "size": 20
    }
  },
  "artist": {
    "method": "POST",
    "path": "/api/v1/admin/artists",
    "bodyType": "form-data",
    "parts": [
      {
        "key": "name",
        "value": "Nghệ sĩ Demo 001",
        "type": "Text"
      },
      {
        "key": "avatar",
        "type": "File",
        "localFile": "fixtures/demo-avatar.png",
        "optional": true
      }
    ]
  },
  "release": {
    "method": "POST",
    "path": "/api/v1/admin/releases",
    "bodyType": "form-data",
    "parts": [
      {
        "key": "title",
        "value": "Album Demo 001",
        "type": "Text"
      },
      {
        "key": "releaseType",
        "value": "ALBUM",
        "type": "Text"
      },
      {
        "key": "releaseDate",
        "value": "2026-11-22",
        "type": "Text"
      },
      {
        "key": "artistIds",
        "value": "{{artistId}}",
        "type": "Text"
      },
      {
        "key": "genreIds",
        "value": "{{genreId}}",
        "type": "Text"
      },
      {
        "key": "cover",
        "type": "File",
        "localFile": "fixtures/demo-avatar.png",
        "optional": true
      }
    ],
    "note": "Nhiều ID: lặp lại key artistIds/genreIds, mỗi dòng một UUID. Không có genre thì bỏ hẳn dòng genreIds. Ảnh tùy chọn: bỏ part File, không gửi chuỗi null."
  },
  "uploadSong": {
    "method": "POST",
    "path": "/api/v1/admin/releases/{{releaseId}}/songs",
    "bodyType": "form-data",
    "parts": [
      {
        "key": "trackNumber",
        "type": "Text",
        "value": "1"
      },
      {
        "key": "title",
        "type": "Text",
        "value": "Âm thử 440 Hz"
      },
      {
        "key": "file",
        "type": "File",
        "localFile": "fixtures/demo-tone.flac"
      }
    ]
  },
  "audio": {
    "method": "GET",
    "path": "/api/v1/songs/{{songId}}/audio/low",
    "qualities": [
      "low",
      "medium",
      "high",
      "lossless"
    ]
  },
  "deleteComment": {
    "method": "DELETE",
    "path": "/api/v1/comments/{{commentId}}"
  },
  "releaseDetail": {
    "method": "GET",
    "path": "/api/v1/releases/{{releaseId}}?page=0&size=20",
    "note": "songs là PageResponse; các field summary nằm ở top level."
  },
  "artistDetail": {
    "method": "GET",
    "path": "/api/v1/artists/{{artistId}}?page=0&size=20",
    "note": "releases là PageResponse."
  },
  "playlistCreate": {
    "method": "POST",
    "path": "/api/v1/playlists",
    "body": {
      "title": "Playlist thư giãn Demo",
      "isPrivate": true
    }
  },
  "playlistUpdate": {
    "method": "PUT",
    "path": "/api/v1/playlists/{{playlistId}}",
    "body": {
      "title": "Playlist cuối tuần Demo",
      "isPrivate": false
    }
  },
  "playlistDetail": {
    "method": "GET",
    "path": "/api/v1/playlists/{{playlistId}}?page=0&size=20",
    "note": "songs là PageResponse."
  },
  "playlistAddSong": {
    "method": "PUT",
    "path": "/api/v1/playlists/{{playlistId}}/songs/{{songId}}"
  },
  "playlistRemoveSong": {
    "method": "DELETE",
    "path": "/api/v1/playlists/{{playlistId}}/songs/{{songId}}"
  },
  "playlistReorder": {
    "method": "PUT",
    "path": "/api/v1/playlists/{{playlistId}}/songs",
    "body": [
      "{{songId}}"
    ],
    "note": "Gửi đủ mọi ID hiện có, mỗi ID đúng một lần; ví dụ này dành cho playlist một bài."
  },
  "playlistDelete": {
    "method": "DELETE",
    "path": "/api/v1/playlists/{{playlistId}}"
  },
  "search": {
    "method": "GET",
    "path": "/api/v1/search?q=Album&page=0&size=20",
    "types": [
      "/search/songs",
      "/search/releases",
      "/search/playlists",
      "/search/artists"
    ]
  },
  "library": {
    "method": "GET",
    "path": "/api/v1/library?sort=RECENT&page=0&size=20",
    "types": [
      "releases",
      "playlists",
      "artists",
      "songs"
    ],
    "sort": [
      "RECENT",
      "NAME",
      "ARTIST"
    ]
  },
  "librarySave": {
    "method": "PUT",
    "path": "/api/v1/library/releases/{{releaseId}}"
  },
  "libraryRemove": {
    "method": "DELETE",
    "path": "/api/v1/library/releases/{{releaseId}}"
  },
  "commentCreate": {
    "method": "POST",
    "path": "/api/v1/songs/{{songId}}/comments",
    "body": {
      "content": "Bài hát này rất hay!"
    }
  },
  "commentReply": {
    "method": "POST",
    "path": "/api/v1/comments/{{commentId}}/replies",
    "body": {
      "content": "Mình cũng thấy vậy."
    }
  },
  "commentList": {
    "method": "GET",
    "path": "/api/v1/songs/{{songId}}/comments?page=0&size=10"
  },
  "commentReplies": {
    "method": "GET",
    "path": "/api/v1/comments/{{commentId}}/replies?page=0&size=10"
  }
}
